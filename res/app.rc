#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Doppler's TTF to C - font to C array converter"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DopplersTTFtoC"
            VALUE "OriginalFilename", "DopplersTTFtoC.exe"
            VALUE "ProductName",      "Doppler's TTF to C"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
